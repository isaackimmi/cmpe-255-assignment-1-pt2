      "pandas": "3.0.5",
      "scikit-learn": "1.9.0"
    }
  },
  "configuration": {
    "rows_argument": 1200,
    "seed": 255,
    "features": [
      "pickup_hour",
      "weekday",
      "is_rush_hour",
      "passenger_count",
      "distance_miles",
      "pickup_zone",
      "dropoff_zone"
    ],
    "numeric_features": [
      "pickup_hour",
      "weekday",
      "is_rush_hour",
      "passenger_count",
      "distance_miles"
    ],
    "categorical_features": [
      "pickup_zone",
      "dropoff_zone"
    ],
    "model": {
      "type": "HistGradientBoostingRegressor",
      "max_iter": 120,
      "max_leaf_nodes": 15,
      "learning_rate": 0.07,
      "random_state": 255
    },
    "split": "sort by pickup_datetime; first 80% train; final 20% holdout",
    "target_policy": {
      "field": "trip_duration_minutes",
      "missing": "exclude",
      "non_numeric": "exclude",
      "non_finite": "exclude",
      "non_positive": "exclude",
      "maximum_minutes": 180.0,
      "above_maximum": "exclude"
    },
    "feature_policies": {
      "pickup_datetime": {
        "invalid": "fail_before_modeling_or_inference"
      },
      "passenger_count": {
        "missing": "impute_in_train_pipeline",
        "invalid": "coerce_to_missing_and_impute",
        "range": [
          1,
          6
        ],
        "integer_only": true
      },
      "distance_miles": {
        "missing": "impute_in_train_pipeline",
        "invalid": "coerce_to_missing_and_impute",
        "range": [
          0,
          100.0
        ]
      },
      "pickup_zone": {
        "missing": "impute_in_train_pipeline",
        "invalid": "reject_before_inference",
        "range": [
          1,
          7
        ],
        "integer_only": true
      },
      "dropoff_zone": {
        "missing": "impute_in_train_pipeline",
        "invalid": "reject_before_inference",
        "range": [
          1,
          7
        ],
        "integer_only": true
      }
    },
    "duplicate_policy": "keep_first_exclude_later_rows",
    "distance_policy": {
      "maximum_miles": 100.0,
      "invalid_values": "coerce to missing and impute in fitted training pipeline"
    }
  },
